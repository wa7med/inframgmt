apiVersion: v1
kind: Config
clusters:
- name: k3s-cluster
  cluster:
    certificate-authority: /etc/rancher/k3s/ssl/ca.crt
    server: https://127.0.0.1:6443
contexts:
- name: u_app-context
  context:
    cluster: k3s-cluster
    user: u_app
current-context: u_app-context
users:
- name: u_app
  user:
    client-certificate: /home/azureuser/sg-env-setup/inframgmt/u_app_certs/u_app.crt
    client-key: /home/azureuser/sg-env-setup/inframgmt/u_app_certs/u_app.pem

